# Vercel 대시보드에서 KV/Redis 스토어를 프로젝트에 연결하면 자동으로 채워집니다.
# (레거시 Vercel KV 연동 이름)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# 또는 Upstash 마켓플레이스 연동을 사용하는 경우 이 이름으로 채워질 수 있습니다.
# (둘 중 하나만 있으면 됩니다)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 선택 사항 — 카카오 개발자 콘솔에서 앱 등록 후 발급받은 JS 키.
# 비워두면 카카오톡 공유 버튼이 자동으로 숨겨집니다.
NEXT_PUBLIC_KAKAO_JS_KEY=
